# Copia este archivo como .env y sustituye los marcadores sólo en tu entorno.
# La API lee esta clave mediante la configuración estándar de ASP.NET Core.
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=54322;Database=postgres;Username=postgres;Password=<local-database-password>"

# Para despliegues persistentes usa la conexión directa si hay IPv6. Si el host
# sólo admite IPv4, usa Supavisor en modo sesión (puerto 5432) y exige SSL.
# ConnectionStrings__DefaultConnection="Host=<host>;Port=5432;Database=postgres;Username=<user>;Password=<password>;SSL Mode=Require"
